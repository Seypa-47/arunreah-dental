# Public browser configuration only. Never place secrets in VITE_* variables.
# Local Worker:
VITE_API_BASE_URL=http://localhost:8787

# Staging Worker (use this value only in an uncommitted staging environment file):
# VITE_API_BASE_URL=https://arunreah-api-staging.arunreah-dental.workers.dev

# Optional public media-serving origin for R2 custom-domain previews. This is not a secret.
# VITE_MEDIA_PUBLIC_BASE_URL=https://media.example.com

# Set only after a Cloudflare Turnstile widget has been created for this frontend hostname.
# This is a public site key, never the TURNSTILE_SECRET_KEY Worker secret.
# VITE_TURNSTILE_SITE_KEY=0x0000000000000000000000000000000AA
