{
  "name": "@arunreah/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:production": "tsc -b && VITE_API_BASE_URL=https://api.arunreahdental.com VITE_MEDIA_PUBLIC_BASE_URL=https://media.arunreahdental.com vite build",
    "seo:generate": "node scripts/generate-sitemap.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@arunreah/shared": "workspace:*",
    "@tanstack/react-query": "^5.74.9",
    "@tanstack/react-query-devtools": "^5.74.9",
    "@tailwindcss/vite": "^4.1.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.1",
    "react-router-dom": "^7.5.3",
    "tailwindcss": "^4.1.4",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.1.2"
  }
}
