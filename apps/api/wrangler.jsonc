{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arunreah-api-development",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "development",
    "CORS_ALLOWED_ORIGINS": "http://localhost:5173",
    "MEDIA_PUBLIC_BASE_URL": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arunreah-dental-development",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "arunreah-dental-development",
    },
  ],
  "env": {
    "staging": {
      "name": "arunreah-api-staging",
      "vars": {
        "APP_ENV": "staging",
        "CORS_ALLOWED_ORIGINS": "http://localhost:5173",
        "MEDIA_PUBLIC_BASE_URL": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arunreah-dental-staging",
          "database_id": "7fc1477b-a22b-4dc8-a2f9-3054ade0a0d1",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "arunreah-dental-staging",
        },
      ],
    },
    "production": {
      "name": "arunreah-api-production",
      "vars": {
        "APP_ENV": "production",
        "CORS_ALLOWED_ORIGINS": "https://www.example.com",
        "MEDIA_PUBLIC_BASE_URL": "https://media.example.com",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arunreah-dental-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "arunreah-dental-production",
        },
      ],
    },
  },
}
