{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arunreah-api-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "development",
    "CORS_ALLOWED_ORIGINS": "http://localhost:5173",
    "ADMIN_APP_BASE_URL": "http://localhost:5173",
    "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1",
    "MEDIA_PUBLIC_BASE_URL": "",
    "EMAIL_NOTIFICATIONS_ENABLED": "false",
    "EMAIL_NOTIFICATION_RECIPIENT": "arunreah.dental@outlook.com",
    "EMAIL_FROM_ADDRESS": "Arunreah Dental Clinic <appointments@send.mekhla.digital>",
    "USAGE_MONITOR_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arunreah-dental-development",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "arunreah-dental-development",
    },
  ],
  "env": {
    "staging": {
      "name": "arunreah-api-staging",
      "account_id": "c3db515eb4220bdcb0df58584e2d6ee0",
      "vars": {
        "APP_ENV": "staging",
        "CORS_ALLOWED_ORIGINS": "https://staging.mekhla.digital",
        "ADMIN_APP_BASE_URL": "https://staging.mekhla.digital",
        "TURNSTILE_HOSTNAMES": "staging.mekhla.digital",
        "MEDIA_PUBLIC_BASE_URL": "https://pub-0dae1b4d79d0465fa30f0366829841b4.r2.dev",
        "EMAIL_NOTIFICATIONS_ENABLED": "true",
        "EMAIL_NOTIFICATION_RECIPIENT": "arunreah.dental@outlook.com",
        "EMAIL_FROM_ADDRESS": "Arunreah Dental Clinic <appointments@send.mekhla.digital>",
        "USAGE_MONITOR_ENABLED": "false",
        "TELEGRAM_NOTIFICATIONS_ENABLED": "true",
        "TELEGRAM_CHAT_ID": "-1005593770369",
      },
      "routes": [
        {
          "pattern": "api.staging.mekhla.digital",
          "custom_domain": true,
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arunreah-dental-staging",
          "database_id": "7fc1477b-a22b-4dc8-a2f9-3054ade0a0d1",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "arunreah-dental-staging",
        },
      ],
    },
    // Production resources are provisioned in the client's Cloudflare account.
    // Follow docs/production-release.md for the release and rollback procedure.
    "production": {
      "name": "arunreah-api-production",
      "account_id": "e3fab4e544dd014935f9289d297c0945",
      "workers_dev": false,
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false,
          "persist": true,
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.05,
          "persist": true,
        },
      },
      "triggers": {
        "crons": ["17 * * * *"],
      },
      "vars": {
        "APP_ENV": "production",
        "CORS_ALLOWED_ORIGINS": "https://arunreahdental.com",
        "ADMIN_APP_BASE_URL": "https://arunreahdental.com",
        "TURNSTILE_HOSTNAMES": "arunreahdental.com",
        // Set to the production R2 custom domain: https://media.arunreahdental.com
        "MEDIA_PUBLIC_BASE_URL": "https://media.arunreahdental.com",
        "EMAIL_NOTIFICATIONS_ENABLED": "true",
        "EMAIL_NOTIFICATION_RECIPIENT": "arunreah.dental@outlook.com",
        "EMAIL_FROM_ADDRESS": "Arunreah Dental Clinic <appointments@send.arunreahdental.com>",
        "USAGE_MONITOR_ENABLED": "true",
        "USAGE_ALERT_RECIPIENT": "Hongbrathna@gmail.com",
        "CLOUDFLARE_ACCOUNT_ID": "e3fab4e544dd014935f9289d297c0945",
        "CLOUDFLARE_WORKERS_DAILY_LIMIT": "100000",
        // The client explicitly approved reusing the clinic's existing bot and group.
        // TELEGRAM_BOT_TOKEN must still be set independently as a production secret.
        "TELEGRAM_NOTIFICATIONS_ENABLED": "true",
        "TELEGRAM_CHAT_ID": "-1005593770369",
      },
      "routes": [
        {
          "pattern": "api.arunreahdental.com",
          "custom_domain": true,
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arunreah-dental-production",
          "database_id": "f37dd4c1-3b83-4339-809e-3bdc66a6ed23",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "arunreah-dental-production",
        },
      ],
    },
  },
}
