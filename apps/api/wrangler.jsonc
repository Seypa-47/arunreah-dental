{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arunreah-api-development",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "development",
    "CORS_ALLOWED_ORIGINS": "http://localhost:5173",
    "MEDIA_PUBLIC_BASE_URL": "",
    "EMAIL_NOTIFICATIONS_ENABLED": "false",
    "EMAIL_NOTIFICATION_RECIPIENT": "Arunreahdental.appointment@outlook.com",
    "EMAIL_FROM_ADDRESS": "Arunreah Dental Clinic <appointments@send.mekhla.digital>",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arunreah-dental-development",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "arunreah-dental-development",
    },
  ],
  "env": {
    "staging": {
      "name": "arunreah-api-staging",
      "vars": {
        "APP_ENV": "staging",
        "CORS_ALLOWED_ORIGINS": "https://staging.mekhla.digital",
        "MEDIA_PUBLIC_BASE_URL": "https://pub-0dae1b4d79d0465fa30f0366829841b4.r2.dev",
        "EMAIL_NOTIFICATIONS_ENABLED": "true",
        "EMAIL_NOTIFICATION_RECIPIENT": "Arunreahdental.appointment@outlook.com",
        "EMAIL_FROM_ADDRESS": "Arunreah Dental Clinic <appointments@send.mekhla.digital>",
        "TELEGRAM_NOTIFICATIONS_ENABLED": "true",
        "TELEGRAM_CHAT_ID": "-1005593770369",
      },
      "routes": [
        {
          "pattern": "api.staging.mekhla.digital",
          "custom_domain": true,
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arunreah-dental-staging",
          "database_id": "7fc1477b-a22b-4dc8-a2f9-3054ade0a0d1",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "arunreah-dental-staging",
        },
      ],
    },
    // Production is not provisioned yet: the D1 database, the R2 bucket and the
    // custom domains below do not exist on the Cloudflare account. Follow
    // docs/production-release.md before the first deploy; a deploy attempted
    // with the placeholder database_id fails fast instead of writing anywhere.
    "production": {
      "name": "arunreah-api-production",
      "vars": {
        "APP_ENV": "production",
        "CORS_ALLOWED_ORIGINS": "https://arunreah.mekhla.digital",
        // Set once the production R2 bucket exists: its r2.dev URL, or a custom media domain.
        "MEDIA_PUBLIC_BASE_URL": "",
        "EMAIL_NOTIFICATIONS_ENABLED": "true",
        "EMAIL_NOTIFICATION_RECIPIENT": "Arunreahdental.appointment@outlook.com",
        "EMAIL_FROM_ADDRESS": "Arunreah Dental Clinic <appointments@send.mekhla.digital>",
        // Enable only after TELEGRAM_BOT_TOKEN is set and the production chat id is confirmed.
        "TELEGRAM_NOTIFICATIONS_ENABLED": "false",
        "TELEGRAM_CHAT_ID": "",
      },
      "routes": [
        {
          "pattern": "api.arunreah.mekhla.digital",
          "custom_domain": true,
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "arunreah-dental-production",
          // Replace with the id printed by `wrangler d1 create arunreah-dental-production`.
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "arunreah-dental-production",
        },
      ],
    },
  },
}
