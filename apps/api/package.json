{
  "name": "@arunreah/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --env=\"\"",
    "build:production": "pnpm --workspace-root check:production-config && wrangler deploy --dry-run --env production",
    "deploy:production": "pnpm --workspace-root check:production-config && wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "db:generate": "node scripts/block-drizzle-generation.mjs",
    "db:migrate:local": "wrangler d1 migrations apply arunreah-dental-development --local",
    "db:migrate:staging": "wrangler d1 migrations apply arunreah-dental-staging --env staging --remote",
    "db:migrate:production": "pnpm --workspace-root check:production-config && wrangler d1 migrations apply arunreah-dental-production --env production --remote",
    "types:generate": "wrangler types worker-configuration.d.ts --env production --strict-vars=false --include-runtime=false",
    "types:check": "wrangler types worker-configuration.d.ts --env production --strict-vars=false --include-runtime=false --check",
    "admin:bootstrap:sql": "node scripts/generate-super-admin-sql.mjs"
  },
  "dependencies": {
    "@arunreah/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.13",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "wrangler": "^4.12.0"
  }
}
